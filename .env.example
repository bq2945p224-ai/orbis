# Database (PostGIS)
DATABASE_URL=postgresql://orbis:orbis@localhost:5432/orbis

# Redis
REDIS_URL=redis://localhost:6379

# Auth / sessions
SESSION_SECRET=change-me-to-a-long-random-string
COOKIE_SECURE=false
WEB_ORIGIN=http://localhost:3000
API_PORT=4000

# Email (Resend) — leave blank to log emails in development
RESEND_API_KEY=
EMAIL_FROM=Orbis <noreply@orbis.local>
# Local/dev: leave false so signup works without inbox access
REQUIRE_EMAIL_VERIFICATION=false

# Admin panel (/admin) — leave empty to disable; set a strong secret in production
ADMIN_SECRET=local-admin-secret-change-me

# Simulation — 1 game day = 4 real hours (SIM_TIME_RATIO=6). Override if needed.
SIM_TIME_RATIO=6
WORLD_TICK_INTERVAL_MS=60000

# Production (see docs/DEPLOY.md)
# API_ORIGIN is used by Next.js rewrites on Vercel (not needed locally if using default)
# API_ORIGIN=https://orbis-api.onrender.com
